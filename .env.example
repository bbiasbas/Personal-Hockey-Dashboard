# Copy to .env and fill in. .env is git-ignored.

# From your Yahoo developer app (README: "Register a Yahoo app")
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must match the redirect URI in your Yahoo app. "oob" = Yahoo shows you a code to paste.
YAHOO_REDIRECT_URI=oob
# Optional: only needed if you have more than one Yahoo NHL team, e.g. 465.l.12345.t.3
YAHOO_TEAM_KEY=

# Postgres in Docker (docker-compose.yml reads PGPORT and PGPASSWORD from here too)
PGPORT=5432
PGPASSWORD=hockey
DATABASE_URL=postgres://hockey:hockey@localhost:5432/hockey
